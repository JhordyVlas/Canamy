generator client {
    provider = "prisma-client"
    output   = "./generated"
}

generator typescriptInterfaces {
    provider    = "prisma-generator-typescript-interfaces"
    bigIntType  = "string"
    decimalType = "string"
    bytesType   = "number[]"
    relations   = "none"
}

datasource db {
    provider = "postgresql"
}

enum Language {
    es
    en
}

model User {
    id             String    @id @default(uuid(7))
    fullName       String    @map("full_name")
    email          String    @unique
    password       String
    language       Language  @default(es)
    isAdmin        Boolean   @default(false) @map("is_admin")
    selectedTeamId String?   @map("selected_team_id")
    verifiedAt     DateTime? @map("verified_at")
    lastLoginAt    DateTime? @map("last_login_at")
    createdAt      DateTime  @default(now()) @map("created_at")
    updatedAt      DateTime  @updatedAt @map("updated_at")

    teams              Team[]
    teamMembers        TeamMember[]
    invitedMembers     TeamMember[]     @relation("invited_by")
    userRoles          UserRole[]
    rolesAssigned      UserRole[]       @relation("assigned_by")
    userPermissions    UserPermission[]
    permissionsGranted UserPermission[] @relation("granted_by")

    @@index([email])
    @@map("users")
}

model Team {
    id        String   @id @default(uuid(7))
    ownerId   String   @map("owner_id")
    name      String   @map("name")
    settings  Json?
    isActive  Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    teamMembers     TeamMember[]
    roles           Role[]
    userRoles       UserRole[]
    userPermissions UserPermission[]
    teamModules     TeamModule[]

    @@index([ownerId])
    @@index([isActive])
    @@map("teams")
}

model Module {
    id        String   @id @default(uuid(7))
    strapiId  String   @unique @map("strapi_id")
    slug      String   @unique
    isActive  Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    permissions Permission[]
    teamModules TeamModule[]

    @@index([isActive, slug])
    @@index([strapiId])
    @@map("modules")
}

enum TeamMemberStatus {
    active
    invited
    suspended
}

model TeamMember {
    userId      String
    teamId      String
    status      TeamMemberStatus
    invitedById String?          @map("invited_by_id")
    addedAt     DateTime         @default(now()) @map("added_at")
    acceptedAt  DateTime?        @map("accepted_at")

    user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
    invitedBy User? @relation(name: "invited_by", fields: [invitedById], references: [id])

    @@id([userId, teamId])
    @@index([teamId, userId])
    @@index([teamId, status])
    @@map("team_members")
}

model Role {
    id        String   @id @default(uuid(7))
    teamId    String   @map("team_id")
    name      String   @map("name")
    slug      String   @unique @map("slug")
    isSystem  Boolean  @default(false) @map("is_system")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
    permissionRoles PermissionRole[]
    userRoles       UserRole[]

    @@index([teamId])
    @@index([isSystem])
    @@map("roles")
}

enum PermissionScope {
    team
    own
    all
}

model Permission {
    id         String          @id @default(uuid(7))
    moduleId   String          @map("module_id")
    subject    String
    action     String
    scope      PermissionScope @default(all)
    conditions Json?
    updatedAt  DateTime        @updatedAt @map("updated_at")

    module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
    permissionRoles PermissionRole[]

    @@unique([subject, action, scope])
    @@index([moduleId])
    @@index([subject])
    @@map("permissions")
}

model PermissionRole {
    permissionId String   @map("permission_id")
    roleId       String   @map("role_id")
    grantedAt    DateTime @default(now()) @map("granted_at")

    permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
    role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@id([permissionId, roleId])
    @@index([permissionId, roleId])
    @@map("permission_roles")
}

model UserRole {
    roleId     String    @map("role_id")
    userId     String    @map("user_id")
    teamId     String    @map("team_id")
    assignedBy String?   @map("assigned_by")
    assignedAt DateTime  @default(now()) @map("assigned_at")
    updatedAt  DateTime  @updatedAt @map("updated_at")
    revokedAt  DateTime? @map("revoked_at")
    expiresAt  DateTime? @map("expires_at")

    role           Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
    user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    team           Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
    assignedByUser User? @relation(name: "assigned_by", fields: [assignedBy], references: [id])

    @@id([userId, roleId, teamId])
    @@index([userId, teamId])
    @@index([roleId, teamId])
    @@index([teamId])
    @@index([expiresAt])
    @@map("user_roles")
}

model UserPermission {
    userId       String    @map("user_id")
    permissionId String    @map("permission_id")
    teamId       String    @map("team_id")
    granted      Boolean   @default(true)
    grantedBy    String?   @map("granted_by")
    reason       String?   @map("reason")
    grantedAt    DateTime  @default(now()) @map("granted_at")
    expiresAt    DateTime? @map("expires_at")
    revokedAt    DateTime? @map("revoked_at")

    user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    team          Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
    grantedByUser User? @relation(name: "granted_by", fields: [grantedBy], references: [id])

    @@id([userId, permissionId, teamId])
    @@index([userId, teamId])
    @@index([teamId])
    @@index([expiresAt])
    @@map("user_permissions")
}

model TeamModule {
    teamId     String    @map("team_id")
    moduleId   String    @map("module_id")
    isEnabled  Boolean   @default(true) @map("is_enabled")
    config     Json?
    enabledAt  DateTime  @default(now()) @map("enabled_at")
    disabledAt DateTime? @map("disabled_at")

    team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
    module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

    @@id([teamId, moduleId])
    @@index([teamId, isEnabled])
    @@map("team_modules")
}

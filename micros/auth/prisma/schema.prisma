generator client {
    provider = "prisma-client"
    output   = "./generated"
}

generator typescriptInterfaces {
    provider          = "prisma-generator-typescript-interfaces"
    bigIntType        = "string"
    decimalType       = "string"
    bytesType         = "number[]"
    relations         = "none"
    jsonType          = "string"
    optionalNullables = true
}

datasource db {
    provider = "postgresql"
}

enum Language {
    es
    en
}

model User {
    id             String    @id @default(uuid(7))
    name           String
    surname        String
    email          String    @unique
    password       String
    language       Language  @default(es)
    verifiedAt     DateTime? @map("verified_at")
    selectedTeamId String?   @map("selected_team_id")
    createdAt      DateTime  @default(now()) @map("created_at")
    updatedAt      DateTime  @updatedAt @map("updated_at")

    teams         TeamMember[]
    invitedUsers  TeamMember[] @relation("invitedBy")
    tokens        Token[]
    grantedClaims Claim[]      @relation("grantedBy")

    @@index([email])
    @@map("users")
}

model Team {
    id   String @id @default(uuid(7))
    name String

    createdAt DateTime     @default(now()) @map("created_at")
    updatedAt DateTime     @updatedAt @map("updated_at")
    members   TeamMember[]

    @@map("teams")
}

model TeamMember {
    id        String   @id @default(uuid(7))
    userId    String   @map("user_id")
    teamId    String   @map("team_id")
    addedAt   DateTime @default(now()) @map("added_at")
    invitedBy String?  @map("invited_by")

    user          User    @relation(fields: [userId], references: [id])
    team          Team    @relation(fields: [teamId], references: [id])
    invitedByUser User?   @relation(name: "invitedBy", fields: [invitedBy], references: [id])
    claims        Claim[]

    @@unique([userId, teamId])
    @@map("team_members")
}

model Token {
    id        String   @id @default(uuid(7))
    userId    String   @map("user_id")
    value     String   @unique
    createdAt DateTime @default(now()) @map("created_at")
    expiresAt DateTime @map("expires_at")

    user User @relation(fields: [userId], references: [id])

    @@index([userId, value])
    @@index([value])
    @@map("tokens")
}

enum Action {
    owner
    manage
    create
    read
    update
    delete
}

enum Subject {
    team
}

model Claim {
    id           String    @id @default(uuid(7))
    teamMemberId String    @map("team_member_id")
    action       Action
    subject      Subject
    grantedAt    DateTime  @default(now()) @map("granted_at")
    revokedAt    DateTime? @map("revoked_at")
    grantedBy    String?   @map("granted_by")

    teamMember    TeamMember @relation(fields: [teamMemberId], references: [id])
    grantedByUser User?      @relation(name: "grantedBy", fields: [grantedBy], references: [id])

    @@unique([teamMemberId, action, subject])
    @@index([action, subject])
    @@map("claims")
}
